<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Guest link generator</title>
    <link rel="stylesheet" href="/css/link-generator.css" />
  </head>
  <body>
    <main>
      <form action="/generate-links" method="POST">
      <h1>Guest link generator</h1>
      <p class="sub">
        Paste your guest names, get one personalised invitation link per guest.
      </p>

      <label for="base">Your invitation website address</label>
      <input
        id="base"
        name="base"
        placeholder="https://example.com/"
        value="https://hoksong-sievmey.netlify.app/"
        spellcheck="false"
      />
      <div class="hint">
        The address where you published the invitation (the page that opens the
        envelope).
      </div>

      <label for="names">Guest names, one per line</label>
      <textarea
        id="names"
        name="names"
        placeholder="លោក សុខា&#10;លោកស្រី ម៉ាលី&#10;Mr. John Smith"
      ></textarea>
      <div class="hint">
        Type the name exactly as you want it to appear in the box, including
        titles such as លោក / លោកស្រី.
      </div>

      <label for="msg">Message to send with the link</label>
      <textarea id="msg" name="msg" style="min-height: 110px">
សូមគោរពអញ្ជើញ {name} ចូលរួមពិធីមង្គលការរបស់យើងខ្ញុំ។ សូមចុចលើតំណខាងក្រោមដើម្បីបើកសំបុត្រអញ្ជើញ៖

{link}</textarea
      >
      <div class="hint">{name} and {link} are filled in for every guest.</div>

      <div class="row">
        <button type="submit" id="gen">Generate Links</button>
      </div>

      <p><a href="/guest-list">View saved guest list</a></p>
      <div class="count" id="count"></div>
      <div id="out"></div>
    </main>
  </body>
</html>
