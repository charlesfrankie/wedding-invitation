generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Guest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  name      String
  createdAt DateTime @default(now())

  @@map("guests")
}
